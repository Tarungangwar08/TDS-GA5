# Copy to .env and fill in YOUR OWN values. Never commit a real key.

# Where the SQLite state file lives. /tmp is fine on Render's free tier.
MAILROOM_DB=/tmp/mailroom.db

# OPTIONAL. Only used for dossiers the deterministic gate cannot classify.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
